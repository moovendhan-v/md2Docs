// InfraAI MCP Server — Architecture

// ── Clients ──────────────────────────────────────────────────────────────────

UserLaptop [icon: monitor, label: "User", color: blue] {
  UserConsole [icon: browser, label: "User Console\n(Workspace + Onboarding)"]
  ClaudeDesktop [icon: laptop, label: "Claude Desktop"]
}

AdminLaptop [icon: monitor, label: "Admin", color: red] {
  AdminConsole [icon: browser, label: "Admin Console\n(Tenants · Logs · Explorer)"]
}

// ── AWS ───────────────────────────────────────────────────────────────────────

AWSCognito [icon: aws-cognito, label: "AWS Cognito\nUser Pool · JWKS · OAuth"]

EC2 [icon: aws-ec2, label: "EC2 — ap-southeast-4 (Melbourne)\nmcp.infraconsulting.com.au"] {

  Caddy [icon: aws-elastic-load-balancing, color: blue, label: caddy Reverse proxy] {
    caddy [icon: docker, color: blue, label: Caddy docker ]
  }

  MCP {
    mcp:[icon: docker, color: blue, label: "infraai-mcp\nFastMCP Server\n:80 (internal)"]
  }

  API {
    API:[icon: docker, color: blue, label: "infraai-api\nFastAPI Server\n:80 (internal)"]
  }

  UI {
    UI: [icon: docker, color: blue, label: "infraai-frontend · Static UI\n:80 (internal)"]
  }

  EBS [icon: storage, label: "Shared Docker Volumes\n(mounted by both containers)"] {
    TenantA [icon: storage, label: "tenant_a/"] {
      templates_A [icon: file, label: "templates/"]
      context_A [icon: file, label: "context/"]
      prompts_A [icon: file, label: "prompts/"]
      File [icon: file]
      File_1 [icon: file]
    }
    TenantB [icon: storage, label: "tenant_b/"] {
      templates_B [icon: file, label: "templates/"]
      context_B [icon: file, label: "context/"]
      prompts_B [icon: file, label: "prompts/"]
    }
    Config [icon: tools, label: "config/\n(hashed tokens + tenant map)"]
  }
}

// ── Routing ───────────────────────────────────────────────────────────────────

Caddy > MCP: "/mcp*\n/authorize · /token · /callback"
Caddy > API: "/api/* (prefix stripped)"
Caddy > UI: "/* (catch-all)"

// ── Claude Desktop ────────────────────────────────────────────────────────────

ClaudeDesktop > Caddy: "HTTPS :443\nBearer JWT → /mcp (SSE)"
MCP > AWSCognito: "validate RS256 JWT\nvia JWKS"
MCP > EBS: "read-only\ntenant namespace"

// ── User Console ──────────────────────────────────────────────────────────────

UserConsole > Caddy: "HTTPS :443 → /\nload UI"
UserConsole > Caddy: "HTTPS :443\nBearer JWT → /api/files/*"
API > AWSCognito: "validate RS256 JWT\nvia JWKS"
API > EBS: "read / write\nfile management"

// ── Admin Console ─────────────────────────────────────────────────────────────

AdminConsole > Caddy: "HTTPS :443\nBearer JWT (admin group)\n→ /api/tenants/* · /api/logs"

// ── PKCE Login Flow ───────────────────────────────────────────────────────────

UserConsole > Caddy: "PKCE → /authorize"
AdminConsole > Caddy: "PKCE → /authorize"
MCP > AWSCognito: "OAuth token exchange"
